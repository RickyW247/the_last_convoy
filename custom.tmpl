    <style>
        /* ===== THE LAST CONVOY loading screen: change the look here ===== */
        :root {                         /* the game's own palette (theme.py _NORMAL) */
            --bg:        #161b1f;   /* BG     (22, 27, 31)    page colour, same as the game's first frame */
            --panel:     #232b30;   /* PANEL  (35, 43, 48)    the loading box */
            --border:    #5e6c6f;   /* BORDER (94, 108, 111)  box outline */
            --accent:    #e2be5d;   /* YELLOW (226, 190, 93)  title and divider */
            --text:      #ebebde;   /* WHITE  (235, 235, 222) main text */
            --text-dim:  #a5b0ae;   /* MUTED  (165, 176, 174) secondary text */
        }

        /* The game's pixel font (Press Start 2P). pages.yml copies assets/fonts/pixel.ttf next to index.html;
           if that file is missing the fallback fonts are used. */
        @font-face {
            font-family: "ConvoyPixel";
            src: url("pixel.ttf") format("truetype");
            font-display: swap;
        }

        #status {
            display: inline-block;
            vertical-align: top;
            margin-top: 20px;
            margin-left: 30px;
            font-weight: bold;
            color: var(--text-dim);
        }

        #progress {
            height: 20px;
            width: 300px;
        }

        #infobox {
            position: fixed;                     /* centred in the viewport by CSS */
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            min-width: 340px;
            max-width: 90vw;
            box-sizing: border-box;
            text-align: center;
            background: var(--panel);
            color: var(--text);
            border: 4px solid var(--border);
            box-shadow: 0 0 0 4px var(--bg), 0 8px 0 4px rgba(0, 0, 0, 0.5);
            font-family: "ConvoyPixel", "Courier New", monospace;
            font-size: 16px;                     /* Press Start 2P is only clean at multiples of 8 px (8, 16, 24, 32) */
            font-weight: normal;
            line-height: 1.6;
            padding: 24px 32px;
            z-index: 999999;
        }
        /* The game title above the message. It is part of the box, so it disappears with it when the game starts. */
        #infobox::before {
            content: "{{cookiecutter.title}}";
            display: block;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--accent);
            color: var(--accent);
            font-size: 24px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Animated dots: 0, 1, 2, 3 dots, then again. Fixed width so the box does not change size. */
        .dots {
            display: inline-block;
            width: 3ch;
            text-align: left;
        }
        .dots::after {
            content: "";
            animation: dots 1.2s steps(1, end) infinite;
        }
        @keyframes dots {
            0%   { content: ""; }
            25%  { content: "."; }
            50%  { content: ".."; }
            75%  { content: "..."; }
        }
        div.emscripten { text-align: center; }
        div.emscripten_border { border: 1px solid black; }
        div.thick_border { border: 4px solid black; }

        /* the canvas *must not* have any border or padding, or mouse coords will be wrong */
        /* average size of droid screen 470dp x 320dp  */
        canvas.emscripten {
            border: 0px none;
            background-color: transparent;
            width: 100%;
            height: 100%;
            z-index: 5;

            padding: 0;
            margin: 0 auto;

            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
        }

        body {
